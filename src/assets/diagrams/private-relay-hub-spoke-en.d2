direction: down

site_a: Site A Gateway (frp-tun) {
  style.fill: "#12394c"
  style.stroke: "#4cc9f0"
  style.font-color: "#ffffff"
}

site_b: Site B Gateway (frp-tun) {
  style.fill: "#12394c"
  style.stroke: "#4cc9f0"
  style.font-color: "#ffffff"
}

site_c: Site C Gateway (frp-tun) {
  style.fill: "#12394c"
  style.stroke: "#4cc9f0"
  style.font-color: "#ffffff"
}

hub: Private Hub Node {
  style.stroke: "#f4a261"
  style.fill: "#4a2840"
  style.font-color: "#ffffff"

  frps: frps / STCP Relay {
    style.fill: "#632d4b"
    style.stroke: "#f4a261"
    style.font-color: "#ffffff"
  }
}

# Preferred P2P Direct Mesh
site_a <-> site_b: "Preferred Direct P2P" {
  style.stroke: "#4cc9f0"
  style.stroke-width: 2
}
site_b <-> site_c: "Preferred Direct P2P" {
  style.stroke: "#4cc9f0"
  style.stroke-width: 2
}
site_c <-> site_a: "Preferred Direct P2P" {
  style.stroke: "#4cc9f0"
  style.stroke-width: 2
}

# Encrypted Datagram Fallback via Hub
site_a -> hub.frps: "Fallback Ciphertext Relay" {
  style.stroke: "#f4a261"
  style.stroke-dash: 4
}
site_b -> hub.frps: "Fallback Ciphertext Relay" {
  style.stroke: "#f4a261"
  style.stroke-dash: 4
}
site_c -> hub.frps: "Fallback Ciphertext Relay" {
  style.stroke: "#f4a261"
  style.stroke-dash: 4
}
